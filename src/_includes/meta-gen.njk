{% set metaTitle = term.title if term else (titleHtml if titleHtml else pageTitle) %}{% set metaDesc = description if description else site.defaultDescription %}{% set pageAbs = site.baseUrl + page.url %}<meta name="description" content="{{ metaDesc }}" />



<link rel="alternate" hreflang="en-us" href="{{ pageAbs }}" />
<link rel="canonical" href="{{ pageAbs }}" />



  <link rel="manifest" href="/manifest.webmanifest" />



<link rel="icon" type="image/png" href="/media/icon_hud37bb86038149fec507f43a2191faf18_50875_32x32_fill_lanczos_center_3.png" />
<link rel="apple-touch-icon" type="image/png" href="/media/icon_hud37bb86038149fec507f43a2191faf18_50875_180x180_fill_lanczos_center_3.png" />

<meta name="theme-color" content="#1565c0" />

<meta property="twitter:card" content="summary" />
<meta property="twitter:image" content="{{ site.baseUrl }}/media/icon_hud37bb86038149fec507f43a2191faf18_50875_512x512_fill_lanczos_center_3.png" />
<meta property="og:site_name" content="{{ site.name }}" />
<meta property="og:url" content="{{ pageAbs }}" />
<meta property="og:title" content="{{ metaTitle }} | {{ site.name }}" />
<meta property="og:description" content="{{ metaDesc }}" /><meta property="og:image" content="{{ site.baseUrl }}/media/icon_hud37bb86038149fec507f43a2191faf18_50875_512x512_fill_lanczos_center_3.png" /><meta property="og:locale" content="en-us" />
{% if kind == "pub" or kind == "post" %}

    <meta
      property="article:published_time"
      content="{{ publishDate | attrT }}"
    />


    <meta property="article:modified_time" content="{{ lastmod | attrT }}">

{% else %}{% set metaUpdated = term.updated if term else (collections.tagList[0].updated if updatedSource == "tags" else (collections.posts[0].data.pdate if updatedSource == "posts" else (collections.pubs[0].data.pdate if updatedSource == "pubs" else null))) %}{% if metaUpdated %}
    <meta property="og:updated_time" content="{{ metaUpdated | attrT }}" />
{% endif %}{% endif %}
{% if kind == "pub" or kind == "post" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "{{ "Article" if kind == "pub" else "BlogPosting" }}",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ pageAbs }}"
  },
  "headline": "{{ jsonldHeadline }}",

  "datePublished": "{{ publishDate | isoZ }}",
  "dateModified": "{{ lastmod | isoZ }}",

  "author": {
    "@type": "Person",
    "name": "{{ authors[0].name }}"
  },

  "publisher": {
    "@type": "Organization",
    "name": "{{ site.name }}",
    "logo": {
      "@type": "ImageObject",
      "url": "{{ site.baseUrl }}/media/icon_hud37bb86038149fec507f43a2191faf18_50875_192x192_fill_lanczos_center_3.png"
    }
  },
  "description": "{{ jsonldDescription if jsonldDescription else metaDesc }}"
}
</script>
{% endif %}
{% set rss = term.rssPath if term else rssPath %}{% if rss %}
    <link rel="alternate" href="{{ rss }}" type="application/rss+xml" title="{{ site.name }}" />
{% endif %}
  <title>{{ metaTitle }} | {{ site.name }}</title>
